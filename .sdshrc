# ~/.sdshrc — sdsh startup file
# Runs automatically every time sdsh starts (interactive or script mode).
# Skip it with: sdsh --norc
#
# Syntax is just normal sdsh commands, one per line.
# Lines starting with # and blank lines are ignored.

# Show the sdsh banner + command cheatsheet on startup
about

# Jump to a preferred working directory (edit to taste, or delete this)
cd ~

# Confirm where we ended up
whereami
